{
  "name": "hotel-pms-site",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "react-router dev",
    "typegen": "react-router typegen",
    "typecheck": "react-router typegen && tsc",
    "build": "react-router typegen && tsc && react-router build && node scripts/generate-headers.ts",
    "verify:headers": "node scripts/verify-headers.ts",
    "generate:social-images": "node scripts/generate-social-images.mjs",
    "lint": "eslint . --max-warnings 0",
    "lint:cycles": "madge --circular --extensions ts,tsx --ts-config tsconfig.json app",
    "knip": "knip",
    "preview": "vite preview --outDir build/client --port 4173",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/outfit": "^5.3.0",
    "@react-router/node": "^7.18.4",
    "clsx": "^2.1.1",
    "i18next": "^25.8.14",
    "isbot": "^5.2.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-i18next": "^17.0.14",
    "react-router": "^7.18.4",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.58.2",
    "@react-router/dev": "^7.18.4",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.10.15",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9.39.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-perf": "^3.3.3",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jsdom": "^28.1.0",
    "knip": "^6.0.6",
    "madge": "^8.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.11",
    "vitest-axe": "^0.1.0"
  }
}
